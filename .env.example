ENVIRONMENT=local
LOG_LEVEL=INFO
API_KEY=local-development-api-key

API_PORT=8000
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_PORT=5433
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/
TEST_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
TEST_RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:${RABBITMQ_PORT}/
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL=0.5
OUTBOX_CLAIM_SECONDS=15
RABBITMQ_PUBLISH_TIMEOUT=5
OUTBOX_RETRY_DELAY=1
PROCESSING_CLAIM_SECONDS=15
PROCESSING_CLAIM_POLL_INTERVAL=0.1
PAYMENT_PROCESSING_MIN_DELAY=2
PAYMENT_PROCESSING_MAX_DELAY=5
PAYMENT_PROCESSING_SUCCESS_RATE=0.9
WEBHOOK_TIMEOUT=5
